# Providers: "fake" runs fully offline; switch to a real vendor when you have keys.
EMBEDDING_PROVIDER=fake
GENERATION_PROVIDER=fake

# Required only when EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Required only when GENERATION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ":memory:" uses an embedded Qdrant; use http://localhost:6333 with docker compose
QDRANT_URL=:memory:
QDRANT_API_KEY=
COLLECTION_NAME=documents

CHUNK_SIZE=400
CHUNK_OVERLAP=80
TOP_K=4

# Retrieval: "hybrid" runs vector search and BM25 and fuses the rankings.
# "dense" and "lexical" run one retriever only, for comparison.
RETRIEVAL_MODE=hybrid
RRF_K=60
# Each retriever returns TOP_K * CANDIDATE_MULTIPLIER passages before fusion and
# reranking. Reranking can only reorder what retrieval returned.
CANDIDATE_MULTIPLIER=4

# Reranking: "lexical" is a cheap offline baseline, "cohere" is a real
# cross-encoder, "none" keeps the fused order.
RERANKER_PROVIDER=lexical
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
